# Настройки для хостинга на Apache. Действуют только для запросов, которые доходят до Apache:
# обычные файлы (html, картинки, шрифты) часто отдаёт напрямую nginx, и тогда этот файл не читается.
# GitHub Pages файл тоже не читает. Если сайт на своём сервере с nginx, те же настройки делаются там
# (см. docs/CONTEXT.md, раздел про кэш и сервер).
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType image/webp .webp
AddType font/woff2 .woff2

<IfModule mod_headers.c>
  # Страницы и служебные файлы всегда свежие: иначе посетители долго видят старую версию из кэша браузера.
  # Стили подключены с меткой содержимого (?v=…), поэтому им кэш не мешает.
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
